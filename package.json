{
  "name": "game-arcade-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:android": "npm run build:apk",
    "perf": "tsx tools/perf-audit.ts",
    "frames": "tsx tools/render-frame.ts",
    "build:apk": "npm run build && cap sync android && node tools/android-build.mjs apk",
    "build:aab": "npm run build && cap sync android && node tools/android-build.mjs aab",
    "version:bump": "node tools/bump-version.mjs",
    "docs:privacy": "tsx tools/write-privacy-doc.ts",
    "store:assets": "tsx tools/make-store-assets.ts",
    "check:store": "tsx tools/check-store-assets.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "canvas2svg": "^1.0.16",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
