<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same navy as the launcher artwork, so icon, splash and the gap before
         the web view paints are one continuous surface. -->
    <color name="splash_background">#0D1627</color>
    <color name="app_background">#0B0E14</color>
    <color name="status_bar">#0B0E14</color>
    <color name="navigation_bar">#0B0E14</color>

    <!-- AppCompat theme colours. These must exist: values/styles.xml refers to
         them from AppTheme, and a missing colour resource fails the Android
         resource link step. -->
    <color name="colorPrimary">#F59E0B</color>
    <color name="colorPrimaryDark">#0B0E14</color>
    <color name="colorAccent">#22C55E</color>
</resources>
